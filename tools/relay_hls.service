[Unit]
Description=Relay HLS giai ma ClearKey cho 4 kenh the thao ON SPORTS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/qweb
ExecStart=/usr/bin/python3 /opt/qweb/relay_hls.py
Restart=always
RestartSec=10
Environment=RELAY_PORT=8099
Environment=RELAY_DIR=/var/lib/hlsrelay
StandardOutput=append:/tmp/relay_hls.out
StandardError=append:/tmp/relay_hls.out

[Install]
WantedBy=multi-user.target
